# Copy to app/.env and fill in. app/.env is gitignored, never committed.

# OAuth token from `claude setup-token` (uses a Claude subscription).
# No token / no access? Ask the Agentic AI team for a CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_CODE_OAUTH_TOKEN=

# JIRA Cloud REST API (read-only client in scripts/jira_search.py etc.)
JIRA_BASE_URL=https://aiinovation.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional Langfuse tracing (no-op unless both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
