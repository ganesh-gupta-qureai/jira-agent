# Copy to app/.env — docker compose auto-loads this file.

# --- Claude auth (required) -----------------------------------------------
# A long-lived token from `claude setup-token` (uses a Claude subscription).
# Run `claude setup-token` on a machine where you're logged in, paste the
# result here. No access / no token? Ask the Agentic AI team.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Alternative: a pay-per-token API key from console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-api...

# --- Your agent's tool config (add what your scripts need) ----------------
# e.g. DB creds or API keys used by scripts/. After adding a var here, also add
# it to the `environment:` list in docker-compose.yml so it reaches the agent.
# DB_HOST=
# DB_PASSWORD=

# --- Langfuse (optional tracing) ------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
